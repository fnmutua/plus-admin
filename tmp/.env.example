# Copy to `.env` in the project root. Used by:
#   - Vite (frontend dev + production build): all `VITE_*` variables
#   - Node server (`node server.js`), chat & video helpers: `VUE_APP_*`, DB, AI, etc.
# Optional overrides: `.env.local` (gitignored) — merged by Vite; load manually for Node if needed.
# Docs: https://vitejs.dev/guide/env-and-mode.html

# --- Frontend (Vite) ---
# Public frontend origin (share links, emails). In dev this is the Vite port (4000).
VITE_APP_HOST=http://localhost:4000
# Optional: override where Vite proxies /api in dev (defaults to http://localhost:$PORT)
# VITE_DEV_API_TARGET=http://localhost:80
VITE_BASE_PATH=/
VITE_API_BASEPATH=base
VITE_APP_TITLE=KeSMIS
VITE_GOOGLE_MAPS_API_KEY=
# VITE_OUT_DIR=dist

# --- Backend / shared (Node, same file) ---
VUE_APP_HOST=http://localhost
VUE_APP_DB_HOST=localhost
VUE_APP_USER=postgres
VUE_APP_PASSWORD=
VUE_APP_DB=your_database
VUE_APP_DB_PORT=5432
# Set to true when the DB requires SSL (e.g. some hosted/production Postgres)
# VUE_APP_DB_SSL=true
VUE_APP_PORT=80
PORT=80
NODE_ENV=development

# Local file storage root (defaults to /data on servers). Use ./data for local dev.
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# GRIEVANCE_UPLOAD_DIR=./data/grievances
# IMAGERY_DIR=./data/imagery
# DATA_REQUEST_UPLOAD_DIR=./data/data-requests
# INCIDENT_UPLOAD_DIR=./data/incidents

# AES_KEY=
# JWT_SECRET=

# Max simultaneous logged-in devices per user (default 5). Set 0 for unlimited.
# MAX_DEVICES_PER_USER=5
# JWT token lifetime in seconds (default 86400 = 24h)
# JWT_EXPIRES_IN_SECONDS=86400

# Skip writing audit trail entries for these user id(s). Comma-separated allowed.
# AUDIT_SKIP_USER_ID=42
# AUDIT_SKIP_USER_ID=42,100

# AI_DB_USER=
# AI_DB_HOST=
# AI_DB_NAME=
# AI_DB_PASSWORD=
# AI_DB_PORT=

# OPENAI_API_KEY=
# XAI_API_KEY=
# OLLAMA_BASE_URL=

# SMS_API_KEY=
# SMS_PARTNER_ID=
# SMS_BALANCE_ALERT_THRESHOLD=500
# SMS_BALANCE_ALERT_ENABLED=true
# SMS_BALANCE_ALERT_CRON=0 8 * * *
# SMS_BALANCE_ALERT_TZ=Africa/Nairobi
# GEOSERVER_USERNAME=
# GEOSERVER_PASSWORD=
