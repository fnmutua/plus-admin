# Copy to `.env` in the project root. Used by:
#   - Vite (frontend dev + production build): all `VITE_*` variables
#   - Node server (`node server.js`), chat & video helpers: `VUE_APP_*`, DB, AI, etc.
# Optional overrides: `.env.local` (gitignored) — merged by Vite; load manually for Node if needed.
# Docs: https://vitejs.dev/guide/env-and-mode.html

# --- Frontend (Vite) ---
VITE_APP_HOST=http://localhost:80
VITE_BASE_PATH=/
VITE_API_BASEPATH=base
VITE_APP_TITLE=KeSMIS
VITE_GOOGLE_MAPS_API_KEY=
# VITE_OUT_DIR=dist

# --- Backend / shared (Node, same file) ---
VUE_APP_HOST=http://localhost
VUE_APP_DB_HOST=localhost
VUE_APP_USER=postgres
VUE_APP_PASSWORD=
VUE_APP_DB=your_database
VUE_APP_DB_PORT=5432
VUE_APP_PORT=80
PORT=80
NODE_ENV=development

# AES_KEY=
# JWT_SECRET=

