# Application Configuration
VITE_APP_TITLE=Plus Admin
VITE_API_BASEPATH=api
VITE_BASE_PATH=/
VITE_APP_HOST=https://your-production-domain.com

# WebSocket Chat Configuration
# For production, use your production domain with secure WebSocket (wss://)
VITE_CHAT_WS_URL=wss://your-production-domain.com/chat

# For development, you can leave this unset to use the default localhost:3001
# VITE_CHAT_WS_URL=ws://localhost:3001/chat

# Build Configuration
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true
VITE_OUT_DIR=dist
